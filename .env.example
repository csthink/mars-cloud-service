# 本地环境变量模板
#
# 用法：
#   1. 复制成 `.env`（与 `run-local.sh` 同级，或模块根目录）：`cp .env.example .env`
#   2. 按需填值。**`.env` 不进版本库**（见 `.gitignore`），`.env.example` 只放变量名与说明。
#
# 值的来源说明：
#   - `mars-cloud-gateway` 的 local profile 需要 Nacos。
#   - `mars-cloud-upms-service` 的 local profile 需要 Nacos，但不连数据源与 Redis。
#   - `mars-cloud-sample-service` 需要 Nacos，不使用数据源或 Redis。
#   - 切换到其他 profile、或将来需要连接数据库与 Redis 时，再填写对应参数。
#
# 注意：Spring Boot 本身不读 `.env` —— 应用读的是**环境变量**。
#   - `./run-local.sh`（即 `mvn spring-boot:run`）会自动读取模块根目录的 `.env`
#   - `java -jar ...` 不会，需要 `set -a && . ./.env && set +a` 先行导出
# 详见模块 README 的「配置」一节。

# ── 运行控制 ────────────────────────────────────────────────
# 激活的 profile，默认 local
SPRING_PROFILES_ACTIVE=local

# 服务端口（端口被占用时改这里）
# 各模块的默认端口不同：gateway 默认 8100，upms-service 默认 8102，sample-service 默认 8103。
# 本变量对本仓所有服务通用——用哪个模块启动，它就覆盖哪个模块的端口。
# SERVER_PORT=8102

# sample-service 的端到端验收脚本用这个变量（默认 8103），与 SERVER_PORT 独立
# SAMPLE_PORT=8103

# local profile 启动时是否发布开发种子快照，默认 true（仅 upms-service）
# 设为 false 可复现「无活动快照 → 所有决策请求返回 503」这条服务态路径
UPMS_LOCAL_FIXTURE_ENABLED=true

# ── Nacos（gateway、upms-service 与 sample-service 的 local profile 必填）────
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE_ID=
NACOS_USERNAME=
NACOS_PASSWORD=

# ── 数据源（local profile 用不到）───────────────────────────
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/mars_upms?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# MYSQL_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=

# ── Redis（local profile 用不到）────────────────────────────
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_DATABASE=2
# SPRING_DATA_REDIS_PASSWORD=

# JWT trust endpoints for sample and UPMS. HTTPS is required outside local/test loopback.
MARS_SECURITY_ISSUER_URI=
MARS_SECURITY_JWK_SET_URI=

# ── 可观测性（全部部署物）────────────────────────────────
# 管理端点的 Basic 认证账号。管理端口是业务端口加 1000，health 匿名可读，其余端点需要它。
# 任一留空时：开发 profile 只暴露 health 与 info 并告警，其他 profile 启动失败；监控面板任一为空即启动失败。
MARS_MANAGEMENT_USERNAME=mars-management
MARS_MANAGEMENT_PASSWORD=

# 调用链导出端点（OTLP over HTTP）。留空则不导出，应用照常启动。
# dev/ 编排的本机中间件按「基础端口加 20000」发布（dev/README.md），
# 其中 Jaeger 的 OTLP HTTP 地址是 http://127.0.0.1:24318/v1/traces。
OTLP_TRACING_ENDPOINT=

# 可观测性验收脚本（verify-observability-e2e.sh）另外读取的地址与端口，部署物不读。
# JAEGER_QUERY=http://127.0.0.1:36686
# LOKI=http://127.0.0.1:23100
# MONITOR_PORT=8190

# ── 监控面板（仅 mars-cloud-monitor）────────────────────
# 面板管理员账号，两项都不能为空，否则启动失败。
MONITOR_USERNAME=monitor-admin
MONITOR_PASSWORD=

# 面板的业务端口、管理端口与注册到 Nacos 的地址都取它。本机用回环；部署时填私网地址，不要绑公网。
# SERVER_ADDRESS=127.0.0.1

# 实例状态变化与实例被移除只写日志通知。钉钉通知暂不支持：
# 设置 SPRING_BOOT_ADMIN_NOTIFY_DINGTALK_WEBHOOK_URL（含空值）会让面板启动失败。
